{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FileMorph",
  "version": "0.1.0",
  "identifier": "com.filemorph.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FileMorph",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}